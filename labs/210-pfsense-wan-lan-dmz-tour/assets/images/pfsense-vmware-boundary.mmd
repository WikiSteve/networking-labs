flowchart LR
    subgraph vmware ["VMware defines these"]
        direction TB
        nat["VMnet8\nNAT\nWAN / outside"]:::blue
        hostonly["VMnet1\nhost-only\nMGMT"]:::purple
    end

    pfsense["pfSense"]:::gold

    subgraph internal ["VMware LAN Segments with pfSense IP networks and DHCP"]
        direction TB
        inside["LAN Segment: inside\npfSense LAN lives here\npfSense runs DHCP here"]:::green
        dmz["LAN Segment: dmz\npfSense DMZ lives here\npfSense runs DHCP here"]:::orange
    end

    nat -->|"WAN"| pfsense
    hostonly -->|"MGMT"| pfsense
    pfsense -->|"LAN"| inside
    pfsense -->|"DMZ"| dmz

