#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
    local address port
    config_load portal
    config_get address upstream address
    config_get port upstream port
    [ -n "$address" ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/portal-relay "$address" "$port"
    procd_set_param respawn 5 10 5
    procd_close_instance
}
